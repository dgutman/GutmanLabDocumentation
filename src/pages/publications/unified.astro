---
import Layout from "../../layouts/Layout.astro";
import { loadPubMedCache } from "../../lib/pubmed";
import {
  buildTitleToPmid,
  heuristicMatchPmid,
  parseScholarBibFile,
} from "../../lib/scholarBib";

const BASE = import.meta.env.BASE_URL || "/";
function link(href: string) {
  if (href === "/") return BASE;
  return BASE + href.replace(/^\//, "");
}

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;

const cache = loadPubMedCache();

// ... rest of the original content with link() instead of withBase
---

<Layout title={title} description={description} noIndex={noIndex}>
  <h1 class="page-title">Unified publications</h1>

  <p class="unified-lede">
    Compare <strong>PubMed</strong> (synced cache) and <strong>Scholar BibTeX</strong>{" "}
    in <strong>one table</strong> sorted by year (newest first), then author. The{" "}
    <strong>Source</strong> column shows whether each row is from PubMed, Scholar, or
    both. The <strong>PubMed PMID</strong> is the
    canonical id when the same paper appears twice. Duplicate links and Scholar
    exclusions live in this browser only—use <strong>Export browser state</strong>{" "}
    to save a JSON snapshot. PubMed "Exclude" uses the same storage as{" "}
    <a href={link("/publications/pubmed-review/")}>PubMed bibliography</a>.
  </p>

  {
    !cache ? (
      <p class="placeholder">
        No PubMed cache. Set email in{" "}
        <code>content/publications/pubmed-config.json</code> and run{" "}
        <code>npm run sync:pubmed</code>. Optional: add{" "}
        <code>scholar-export.bib</code> and rebuild.
      </p>
    ) : (
      <div class="unified-content">Loading...</div>
    )
  }
</Layout>

<style>
  .unified-lede {
    max-width: 62ch;
    color: var(--muted);
    margin-bottom: 1.25rem;
    line-height: 1.45;
    font-size: 0.95rem;
  }
  .placeholder {
    color: var(--muted);
    font-style: italic;
    margin: 1.5rem 0;
  }
</style>
