---
import Layout from "../../layouts/Layout.astro";
import GoogleScholarLinks from "../../components/GoogleScholarLinks.astro";

const BASE = import.meta.env.BASE_URL || "/";

function link(href: string) {
  return href === "/" ? BASE : BASE + href;
}

const subsections = [
  { href: "/publications/coverage/", title: "OpenAlex vs PubMed coverage" },
  { href: "/publications/pubmed-review/", title: "PubMed bibliography" },
  { href: "/publications/unified/", title: "PubMed + Scholar (unified)" },
  { href: "/publications/scholar-bibtex/", title: "Scholar BibTeX export" },
];

const categories = [
  { href: "/publications/papers/", title: "Peer reviewed journal articles" },
  { href: "/publications/presentations/", title: "Presentations" },
  { href: "/publications/chapters/", title: "Book chapters" },
  { href: "/publications/posters-abstracts/", title: "Posters and abstracts" },
];
---

<Layout title="Publications">
  <GoogleScholarLinks variant="compact" />

  <p class="pub-index-note">
    {
      subsections.map((s) => (
        <a href={link(s.href)}>{s.title}</a>
      ))
    }
  </p>

  <ul class="pub-list">
    {
      categories.map((c) => (
        <li>
          <a href={link(c.href)}>{c.title}</a>
        </li>
      ))
    }
  </ul>

  <p class="placeholder">Publication content is being migrated from the original WordPress site.</p>
</Layout>

<style>
  .pub-index-note {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .pub-index-note a {
    font-weight: 600;
  }
</style>
