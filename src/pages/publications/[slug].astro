---
const BASE_URL = import.meta.env.BASE_URL;
import Layout from "../../layouts/Layout.astro";
import { loadFragment } from "../../lib/fragments";
import { publicationSections } from "../../data/site";

export function getStaticPaths() {
  return publicationSections.map(({ slug, title, fragment }) => ({
    params: { slug },
    props: { title, fragment },
  }));
}

interface Props {
  title: string;
  fragment: string;
}

const { slug } = Astro.params;
const { title, fragment } = Astro.props;

const html = loadFragment(fragment);
---

<Layout title={title}>
  <a href={BASE_URL + ""}>&larr; Back to Publications</a>
  <h1 class="page-title">{title}</h1>
  {
    html ? (
      <div class="content-recovered" set:html={html} />
    ) : (
      <p class="placeholder">
        No recovered content for this topic yet. This is a holding page.
      </p>
    )
  }
</Layout>
