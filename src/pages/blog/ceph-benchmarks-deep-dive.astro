    font-size: 1.1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-post p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .blog-post ul, .blog-post ol {
    margin: 0 0 1rem 1.5rem;
    line-height: 1.75;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin: 1.2rem 0;
  }

  .data-table th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    background: var(--border);
    font-weight: 600;
  }

