    color: #b33;
  }

  .callout {
    background: #e8f4f0;
    border-left: 4px solid var(--accent);
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    border-radius: 0 6px 6px 0;
    font-size: 0.95rem;
  }

  .callout.warn {
