---
import Layout from "../../layouts/Layout.astro";
import { withBase } from "astro";
import { loadFragment } from "../../lib/fragments";
import { researchAreas } from "../../data/site";

export function getStaticPaths() {
  return researchAreas.map(({ slug, title }) => ({
    params: { slug },
    props: { title },
  }));
}

interface Props {
  title: string;
}

const { slug } = Astro.params;
const { title } = Astro.props;

const fragmentName = `research-areas__${slug}`;
const html = loadFragment(fragmentName);
---

<Layout title={title}>
  <a href={withBase("/research/")}>&larr; Back to Research</a>
  <h1 class="page-title">{title}</h1>
  {
    html ? (
      <div class="content-recovered" set:html={html} />
    ) : (
      <p class="placeholder">
        No recovered content for this topic yet. This is a holding page.
      </p>
    )
  }
</Layout>
