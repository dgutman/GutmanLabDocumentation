---
import Layout from "../../layouts/Layout.astro";
import { researchAreas } from "../../data/site";

const BASE = import.meta.env.BASE_URL?.replace(/\/$/, "") || "";
function link(href: string) {
  if (href === "/") return BASE;
  return BASE + href;
}
---

<Layout title="Research">
  <h1 class="page-title">Research</h1>
  <div class="card-grid">
    {
      researchAreas.map((a) => (
        <article class="card">
          <div class="card__body">
            <h2>
              <a href={link("/research/" + a.slug + "/")}>{a.title}</a>
            </h2>
          </div>
        </article>
      ))
    }
  </div>
  <p class="placeholder">Detailed content for each research area is being updated.</p>
</Layout>
