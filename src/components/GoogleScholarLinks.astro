---
import { googleScholar } from "../data/site";

const BASE = import.meta.env.BASE_URL || "/";
function link(href: string) {
  if (href === "/") return BASE;
  return BASE + href.replace(/^\//, "");
}

interface Props {
  variant?: "default" | "compact";
}

const { variant = "default" } = Astro.props;
---

{variant === "compact" ? (
  <div class="gs-links">
    <a href={link("/publications/coverage/")}>OpenAlex vs PubMed gaps</a> — we cannot
    pull from Google Scholar directly.
    <a href={link("/publications/scholar-bibtex/")}>View BibTeX in the site</a> (after
    running ``npm run sync:scholar`` or adding the export).
  </div>
) : (
  <section class="gs-panel" aria-labelledby="gs-heading">
    <h2 id="gs-heading" class="gs-panel__title">Google Scholar</h2>
    <p class="gs-panel__note">The site does not pull from Google Scholar (no public API). Links below go directly to Google.</p>
    <div class="gs-links">
      <a href={googleScholar.profileUrl} target="_blank" rel="noopener noreferrer">{googleScholar.profileUrl}</a>
    </div>
  </section>
)}

<style>
  .gs-panel {
    margin-top: 3rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem 2rem;
    max-width: 600px;
  }
  .gs-panel__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .gs-panel__note {
    margin: 0.5rem 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .gs-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .gs-links a {
    font-size: 0.92rem;
    color: var(--accent);
  }
</style>
