---
import { nav, siteTitle } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteVersion = "v0.1.0";
---

<header class="site-header">
  <div class="site-header__inner">
    <h1 class="site-title">
      <a href="/">{siteTitle}</a>
    </h1>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          nav.map(({ href, label }) => {
            const normalized = href.replace(/\/$/, "") || "/";
            const current =
              normalized === "/"
                ? pathname === "/"
                : pathname === normalized ||
                  pathname.startsWith(normalized + "/");
            return (
              <li>
                <a href={href} aria-current={current ? "page" : undefined}>
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
  <div class="site-version">{siteVersion}</div>
</header>
