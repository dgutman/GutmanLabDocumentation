---
import { nav, siteTitle } from "../data/site";
import { withBase } from "astro:routing";

const siteVersion = "v0.5.0";
---

<header class="site-header">
  <div class="site-header__inner">
    <h1 class="site-title">
      <a href={withBase("/")}>{siteTitle}</a>
    </h1>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={withBase(href)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="site-version">{siteVersion}</div>
</header>
