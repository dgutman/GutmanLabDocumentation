---
// Display merged papers from the authoritative JSON
// Sources: PubMed cache (primary) + recovered HTML (supplemental)
import { papers } from '../data/merged-papers.json';

// Group by year
const groupedByYear: Record<string, typeof papers> = {};
for (const paper of papers) {
  const year = String(paper.year || 'unknown');
  if (!groupedByYear[year]) groupedByYear[year] = [];
  groupedByYear[year].push(paper);
}
---

<div class="papers-list">
  {Object.entries(groupedByYear)
    .sort(([a], [b]) => b.localeCompare(a)) // newest year first
    .map(([year, yearPapers]) => (
      <div class="paper-year">
        <h3 class="paper-year-label">{year}</h3>
        <ol class="paper-items">
          {yearPapers.map((paper) => (
            <li class="paper-item">
              <span class="paper-citation">{paper.citation}</span>
              {paper.link ? (
                <a href={paper.link} target="_blank" rel="noopener" class="paper-link">
                  {paper.type === 'pubmed' ? `PubMed ${paper.pmid}` : 'Link'}
                </a>
              ) : null}
            </li>
          ))}
        </ol>
      </div>
    ))}
</div>

<style>
  .papers-list {
    margin: 1rem 0;
  }

  .paper-year {
    margin-bottom: 1.5rem;
  }

  .paper-year-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent);
    margin: 1rem 0 0.5rem 0;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid var(--accent);
  }

  .paper-items {
    list-style: decimal;
    padding-left: 1.5rem;
    margin: 0.5rem 0 0 0;
  }

  .paper-item {
    margin: 0.5rem 0;
    line-height: 1.6;
    display: block;
  }

  .paper-citation {
    color: var(--text);
    margin-right: 0.5rem;
  }

  .paper-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-size: 0.9em;
    white-space: nowrap;
  }

  .paper-link:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 768px) {
    .paper-citation {
      display: block;
      margin-bottom: 0.25rem;
    }
  }
</style>
